<UserControl x:Class="DataComparison.Fragment.ComparisonTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="compid" FontWeight="Bold"/>
        <TextBox x:Name="CompIdTextBox" Grid.Row="1" Grid.Column="0"
                 Margin="0,0,12,6" Padding="4"
                 TextChanged="CompIdTextBox_TextChanged"/>

        <Label Grid.Row="2" Grid.Column="0" Content="subcompid" FontWeight="Bold"/>
        <TextBox x:Name="SubCompIdTextBox" Grid.Row="3" Grid.Column="0"
                 Margin="0,0,12,6" Padding="4" VerticalAlignment="Top"
                 TextChanged="SubCompIdTextBox_TextChanged"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Table" FontWeight="Bold"/>
        <Label Grid.Row="0" Grid.Column="1" Content="欄位搜尋:" FontWeight="Bold" Margin="12,0,0,0"/>

        <TextBox x:Name="TableFilterTextBox" Grid.Row="5" Grid.Column="0"
                 Margin="0,0,12,6" Padding="4" VerticalAlignment="Top"
                 TextChanged="TableFilterTextBox_TextChanged"/>
        <TextBox x:Name="ColumnFilterTextBox" Grid.Row="1" Grid.Column="1"
                 Margin="12,0,0,6" Padding="4"
                 TextChanged="ColumnFilterTextBox_TextChanged"/>

        <ListBox x:Name="TableListBox" Grid.Row="6" Grid.RowSpan="7" Grid.Column="0"
                 Margin="0,0,12,0"
                 SelectionChanged="TableListBox_SelectionChanged"/>

        <Label Grid.Row="2" Grid.Column="1" Content="選擇欄位:" FontWeight="Bold" Margin="12,0,0,0"/>

        <Border Grid.Row="3" Grid.Column="1" Height="104" Margin="12,0,0,8" Grid.RowSpan="4"
                BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <WrapPanel x:Name="ColumnButtonsPanel" Margin="4"/>
            </ScrollViewer>
        </Border>

        <Label Grid.Row="7" Grid.Column="1" Content="where條件:" FontWeight="Bold" Margin="12,0,0,0"/>

        <TextBox x:Name="WhereConditionTextBox" Grid.Row="8" Grid.Column="1" Grid.RowSpan="2"
                 Margin="12,0,0,8" Padding="4" Height="60"
                 TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto"/>

        <StackPanel x:Name="SqlKeywordButtonsPanel" Grid.Row="10" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Left" Margin="12,0,0,0">
            <Button Content="and" Tag="and" Width="56" Height="28" Margin="0,0,4,0" Click="WhereInsertButton_Click"/>
            <Button Content="or" Tag="or" Width="56" Height="28" Margin="0,0,4,0" Click="WhereInsertButton_Click"/>
            <Button Content="not" Tag="not" Width="56" Height="28" Margin="0,0,4,0" Click="WhereInsertButton_Click"/>
            <Button Content="exists" Tag="exists" Width="56" Height="28" Margin="0,0,4,0" Click="WhereInsertButton_Click"/>
            <Button Content="(" Tag="(" Width="36" Height="28" Margin="0,0,4,0" Click="WhereInsertButton_Click"/>
            <Button Content=")" Tag=")" Width="36" Height="28" Margin="0,0,4,0" Click="WhereInsertButton_Click"/>
            <Button Content="=" Tag="=" Width="36" Height="28" Click="WhereInsertButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="12,0,0,0">
            <Button x:Name="QueryButton" Content="查詢" Width="90" Height="28"
                    Margin="0,0,8,0" Click="QueryButton_Click"/>
            <Button x:Name="ClearButton" Content="清空" Width="90" Height="28"
                    Margin="0,0,8,0" Click="ClearButton_Click"/>
            <Button x:Name="ClearWhereButton" Content="清除where" Width="90" Height="28"
                    Click="ClearWhereButton_Click"/>
        </StackPanel>

        <Border Grid.Row="11" Grid.Column="1" Margin="12,8,0,0"
                BorderBrush="Gray" BorderThickness="1">
            <ScrollViewer x:Name="ResultScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel x:Name="ResultDataGrid" Orientation="Vertical"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="12,8,0,0">
            <Button x:Name="CompareButton" Content="資料比對" Width="90" Height="28"
                    Margin="0,0,8,0" IsEnabled="False" Click="CompareButton_Click"/>
            <Button x:Name="RestoreButton" Content="資料復原" Width="90" Height="28"
                    IsEnabled="False" Click="RestoreButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
