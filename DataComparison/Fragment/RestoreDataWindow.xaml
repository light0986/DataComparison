<Window x:Class="DataComparison.Fragment.RestoreDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="資料還原" Height="700" Width="900"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1">
                <DataGrid x:Name="TopDataGrid" AutoGenerateColumns="True" IsReadOnly="True"/>
            </Border>

            <TextBlock Grid.Row="1" Text="↓" FontSize="32" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,8,0,8"/>

            <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1">
                <DataGrid x:Name="BottomDataGrid" AutoGenerateColumns="True" IsReadOnly="True"/>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="ConfirmButton" Content="確認" Width="90" Height="28" Margin="0,0,8,0" Click="ConfirmButton_Click"/>
                <Button x:Name="CancelButton" Content="取消" Width="90" Height="28" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="MaskOverlay" Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="#4D000000"/>
            </Grid.Background>
            <ProgressBar x:Name="RestoreProgressBar" Width="240" Height="24"
                         Minimum="0" Maximum="5"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
